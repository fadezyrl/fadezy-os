# -----------------------------------------------------------------------------
# FADEZY OS — environment template
# Copy to backend/.env and frontend/.env.local as needed. Never commit secrets.
# -----------------------------------------------------------------------------

# Web (frontend/.env.local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# API (backend/.env)
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (web clients).
# Native mobile apps do not use browser CORS; keep this for Next.js and future webviews.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase project (Dashboard → Project Settings → API / Database)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Existing Postgres connection (Session Pooler or direct). Do not invent credentials.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: API service metadata
API_SERVICE_NAME=fadezy-api
API_VERSION=0.1.0
